# ── AI ──────────────────────────────────────────────────────────────────────
# Anthropic: with a key, Eva answers through /api/chat; without one the
# studio's rule brain answers from the room's facts and the catalogue.
ANTHROPIC_API_KEY=
# the model Eva speaks with (default claude-opus-5-5)
# EVA_MODEL=
# fal.ai: with a key, Generate in the + strip draws a room item with Flux
# and turns it into a mesh with Hunyuan 3D; without one the item stands as
# a shape. Room items set the scene and are not for sale.
FAL_KEY=

# ── Data ────────────────────────────────────────────────────────────────────
# Neon Postgres (Drizzle)
DATABASE_URL=
# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# ── Infra ───────────────────────────────────────────────────────────────────
# Upstash Redis (rate limits, daily caps)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Sentry (optional)
SENTRY_DSN=

# ── Payments (OFF for now; Stripe is not installed) ─────────────────────────
# STRIPE_SECRET_KEY=
