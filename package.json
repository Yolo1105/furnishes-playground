{
  "name": "furnishes-playground",
  "version": "0.1.0",
  "private": true,
  "description": "Furnishes studio — pnpm workspace: apps/web (Next.js), packages/domain, packages/scene.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @furnishes/web dev",
    "build": "pnpm --filter @furnishes/web build",
    "start": "pnpm --filter @furnishes/web start",
    "lint": "eslint .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel --if-present test",
    "e2e": "pnpm --filter @furnishes/web e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "cbor-extract",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
