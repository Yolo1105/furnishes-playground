# Eva: a model behind the chat; without a key she answers from the rules
ANTHROPIC_API_KEY=
EVA_MODEL=

# What the providers cost, counted in the cost log and capped a day: US
# dollars per million tokens in and out, per generated item, and the
# day's share per caller and for the whole site (0 is no cap)
EVA_USD_PER_M_IN=
EVA_USD_PER_M_OUT=
FAL_USD_PER_ITEM=
DAILY_USD_PER_CALLER=
DAILY_USD=

# Generate: pictures and meshes for room items; without a key they stand as shapes
FAL_KEY=

# Checkout: with a secret key, placing an order opens a hosted Stripe
# payment page; the webhook secret checks what Stripe sends back to
# /api/webhooks/stripe (set the endpoint up in the Stripe dashboard)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The limits are counted on a hosted run; RATE_LIMITS=on counts them on
# a development server too (the unit test sets it)
RATE_LIMITS=

# The shares: how much of the studio one caller gets, and how heavy a
# mirrored document or a shared room may be (bytes of JSON). The
# defaults are the product's rules; set one to tune a deployment
CHAT_TURNS_PER_HOUR=
ITEMS_PER_HOUR=
REVIEWS_PER_DAY=
WAITLIST_PER_HOUR=
HELP_PER_DAY=
DOCUMENT_BYTES=

# The site, for a deployment under another name or address (baked in
# at build time); without them it is Furnishes Studio at furnish-es.com
NEXT_PUBLIC_SITE_NAME=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_CONTACT=

# Accounts: Neon Postgres in production; without a URL, PGlite keeps the
# database under .data/pglite (or DATA_DIR)
DATABASE_URL=
DATA_DIR=

# Accounts: the signing secret (32 characters or more; `openssl rand -base64 32`)
# and the site's address in production (https://furnish-es.com)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Mail from the studio (the link that confirms an email, the link that
# resets a password): Resend's key and the sender; without a key a
# development server keeps the mail under .data/mail.json
RESEND_API_KEY=
MAIL_FROM=

# Google as a way in: the OAuth client, and the public flag that shows
# the button (the redirect URI is <site>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_AUTH_GOOGLE=

# Operations: the accounts that may open /ops (comma-separated emails;
# nobody without it), and the secret the host's nightly cron sends to
# /api/cron/retention (`openssl rand -hex 16`; Vercel sends it as the
# bearer token on its own). A development server sets both in
# .env.development
ADMIN_EMAILS=
CRON_SECRET=
