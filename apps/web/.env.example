# Eva: a model behind the chat; without a key she answers from the rules
ANTHROPIC_API_KEY=
EVA_MODEL=

# Generate: pictures and meshes for room items; without a key they stand as shapes
FAL_KEY=

# Checkout: no provider is wired in this build; a key only changes the message
STRIPE_SECRET_KEY=

# Accounts: Neon Postgres in production; without a URL, PGlite keeps the
# database under .data/pglite (or DATA_DIR)
DATABASE_URL=
DATA_DIR=

# Accounts: the signing secret (32 characters or more; `openssl rand -base64 32`)
# and the site's address in production (https://furnish-es.com)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
